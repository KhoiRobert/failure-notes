# Database Configuration (local dev default; use real credentials in production via env)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/failure_notes

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Security
# ⚠️ CHANGE THESE IN PRODUCTION!
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# AI Service Configuration (for future AI integration)
AI_API_KEY=your-ai-api-key-here
AI_API_URL=https://api.openai.com/v1
AI_MODEL=gpt-4

# Logging
LOG_LEVEL=INFO

# Environment
ENVIRONMENT=development
