# Database Configuration (local dev default; use real credentials in production via env)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/failure_notes

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Admin (comma-separated emails for GET /users/, GET /users/{id})
ADMIN_EMAILS=admin@example.com

# Security
# ⚠️ CHANGE THESE IN PRODUCTION!
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# AI Service (root cause detection). Optional: leave AI_API_KEY empty to skip LLM.
# Groq (free tier): https://console.groq.com → get key, then:
#   AI_API_URL=https://api.groq.com/openai/v1
#   AI_MODEL=llama-3.1-70b-versatile  (or llama-3.1-8b-instant)
# OpenAI: AI_API_URL=https://api.openai.com, AI_MODEL=gpt-4o-mini
AI_API_KEY=your-groq-or-openai-key-here
AI_API_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-20b

# Logging
LOG_LEVEL=INFO

# Environment
ENVIRONMENT=development

# Email Alerts (Gmail SMTP)
# Enable email alerts when usage_count exceeds threshold
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=your-email@gmail.com
EMAIL_SMTP_PASSWORD=your-gmail-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_ALERT_THRESHOLD=2
